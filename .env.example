# ============================================================
#  GreenAsset — Ortam Değişkenleri ÖRNEĞİ
#  Bu dosyayı kopyalayıp ".env" olarak kaydet:
#     Copy-Item .env.example .env
#  .env dosyası .gitignore'da — asla GitHub'a gitmez.
# ============================================================

# --- PostgreSQL / PostGIS ---
POSTGRES_USER=greenasset
POSTGRES_PASSWORD=greenasset_dev_2026
POSTGRES_DB=greenasset
POSTGRES_PORT=5432

# --- pgAdmin (web arayüzü: http://localhost:5050) ---
# NOT: pgAdmin ".local" gibi rezerve uzantıları reddediyor — gerçek bir TLD kullan
PGADMIN_EMAIL=admin@greenasset.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# --- Backend (FastAPI) ---
BACKEND_PORT=8000
# DİKKAT: host adı "localhost" DEĞİL "db" — Docker ağı içinde
# container'lar birbirini servis adıyla bulur.
DATABASE_URL=postgresql+psycopg://greenasset:greenasset_dev_2026@db:5432/greenasset
# React dev server'ın adresi — CORS izni için gerekli
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Çalışma ortamı ---
# "production" yapılırsa güvenlik kontrolleri sertleşir; en önemlisi,
# aşağıdaki varsayılan SECRET_KEY ile uygulama HİÇ AÇILMAZ.
ENVIRONMENT=development

# --- Kimlik doğrulama ---
# ⚠️ ÜRETİMDE MUTLAKA DEĞİŞTİR. Bu anahtarı bilen herkes geçerli oturum
# bileti (JWT) üretebilir, yani istediği kullanıcı gibi davranabilir —
# parolayı bilmesine bile gerek kalmaz.
# Rastgele bir değer üretmek için:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=gelistirme-icin-gizli-anahtar-uretimde-degistir
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Frontend ---
# Docker ile çalıştırınca Nginx bu portta servis eder (http://localhost:3000)
# Geliştirmede `npm run dev` 5173'te çalışır, ikisi çakışmaz.
FRONTEND_PORT=3000
# Boş bırak: tarayıcı /api/v1 göreli adresini kullanır, Nginx backend'e
# yönlendirir. Böylece CORS'a hiç gerek kalmaz.
VITE_API_URL=
# Haritanın açılış konumu: İTÜ Ayazağa Yerleşkesi / Sarıyer, İstanbul
VITE_MAP_CENTER_LNG=29.0270
VITE_MAP_CENTER_LAT=41.1050
VITE_MAP_ZOOM=13
